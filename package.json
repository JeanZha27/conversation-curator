{
  "name": "conversation-curator",
  "version": "0.1.0",
  "description": "Privacy-first local CLI and Codex Skill for classifying ChatGPT conversation exports without including message content in reports.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "keywords": [
    "chatgpt-export",
    "conversation-analysis",
    "privacy",
    "local-first",
    "data-redaction",
    "codex-skill",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanZha27/conversation-curator.git"
  },
  "homepage": "https://github.com/JeanZha27/conversation-curator#readme",
  "bugs": {
    "url": "https://github.com/JeanZha27/conversation-curator/issues"
  },
  "bin": {
    "conversation-curator": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm policy:repository && pnpm typecheck && pnpm test && pnpm build",
    "policy:repository": "node scripts/repository-policy-check.ts",
    "benchmark:memory": "node scripts/memory-benchmark.ts",
    "benchmark:input-limit": "node scripts/memory-benchmark.ts --items 4000 --payload-bytes 65000 --max-rss-mib 256",
    "benchmark:large-items": "node scripts/memory-benchmark.ts --items 30 --payload-bytes 7500000 --max-rss-mib 256",
    "benchmark:mapping-nodes": "node scripts/mapping-node-benchmark.ts",
    "compatibility:private": "node --max-old-space-size=96 --max-semi-space-size=2 scripts/compatibility-check.ts",
    "pack:check": "pnpm pack --dry-run --json",
    "package:smoke": "node scripts/package-smoke.ts",
    "prepack": "node node_modules/typescript/bin/tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
